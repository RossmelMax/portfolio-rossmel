---
import type { Lang } from '../data/profile';
import { experience } from '../data/profile';
import { t, fmtMonth } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---
<section id="experience" class="px-5 py-32 md:px-10">
  <h2 class="kicker mb-10">{s.experience.kicker}</h2>
  <div data-timeline class="relative">
    <div class="absolute left-0 top-0 h-full w-px bg-line md:left-[25%]"></div>
    <div data-progress class="absolute left-0 top-0 h-full w-px origin-top bg-accent md:left-[25%]"></div>
    {experience.filter((e) => !e.draft).map((job) => (
      <article class="relative grid gap-6 pb-24 pl-8 md:grid-cols-4 md:pl-0">
        <span class="absolute left-[-4px] top-2 h-2 w-2 rounded-full bg-accent md:left-[calc(25%-4px)]"></span>
        <div class="kicker md:pr-10 md:text-right" data-reveal>
          {fmtMonth(job.start, lang)} — {fmtMonth(job.end, lang)}
          <br /><span class="normal-case tracking-normal">{job.type[lang]}</span>
        </div>
        <div class="md:col-span-3 md:pl-12">
          <h3 data-split class="display text-4xl font-semibold md:text-6xl">{job.company[lang]}</h3>
          <p class="mt-3 text-accent" data-reveal>{job.role[lang]}</p>
          <p class="mt-6 max-w-2xl text-lg text-fg/85" data-reveal>{job.summary[lang]}</p>
          <ul class="mt-8 max-w-2xl space-y-3 text-muted">
            {job.bullets[lang].map((b) => <li class="flex gap-3" data-reveal><span class="text-accent">→</span><span>{b}</span></li>)}
          </ul>
          <ul class="mt-8 flex flex-wrap gap-2">
            {job.stack.map((x) => <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{x}</li>)}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
