---
import type { Lang } from '../data/profile';
import { workflow, aiJourney } from '../data/profile';
import { t } from '../data/i18n';
import { postUrlById } from '../data/blog';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const essayUrl = await postUrlById('programar-antes-de-la-ia', lang);
---
<section id="workflow" class="px-5 py-32 md:px-10">
  <p class="kicker mb-10">{s.workflow.kicker}</p>
  <h2 data-split class="display max-w-5xl text-5xl font-bold md:text-8xl">{s.workflow.title}</h2>

  <p class="kicker mb-8 mt-24">{s.workflow.journey}</p>
  <ol class="grid gap-10 border-t border-line pt-10 md:grid-cols-4 md:gap-8">
    {aiJourney.map((j, i) => (
      <li class="relative" data-reveal data-reveal-delay={i * 0.08}>
        <span class="absolute -top-[2.875rem] left-0 hidden h-3 w-3 md:block rounded-full border border-line bg-bg" style={i === aiJourney.length - 1 ? 'background: var(--accent); border-color: var(--accent)' : ''}></span>
        <span class="font-mono text-sm text-accent">{j.period[lang]}</span>
        <h3 class="display mt-3 text-2xl font-semibold">{j.title[lang]}</h3>
        <p class="mt-3 text-muted">{j.body[lang]}</p>
        {j.tools && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {j.tools.map((tool) => <li class="rounded-full border border-line px-3 py-1 font-mono text-xs">{tool}</li>)}
          </ul>
        )}
      </li>
    ))}
  </ol>
  <a href={essayUrl} data-hover class="mt-12 inline-flex items-center gap-2 text-accent underline-offset-4 hover:underline">{s.workflow.essay} →</a>

  <p class="kicker mb-8 mt-24">{s.workflow.steps}</p>
  <ol class="grid gap-px overflow-hidden rounded-3xl border border-line bg-line md:grid-cols-4">
    {workflow.map((w, i) => (
      <li class="group bg-bg p-8 transition-colors hover:bg-accent hover:text-accent-ink" data-reveal data-reveal-delay={i * 0.08}>
        <span class="font-mono text-xs opacity-60">0{i + 1}</span>
        <h3 class="display mt-16 text-3xl font-semibold">{w.title[lang]}</h3>
        <p class="mt-4 text-muted group-hover:text-accent-ink/80">{w.body[lang]}</p>
      </li>
    ))}
  </ol>
</section>
