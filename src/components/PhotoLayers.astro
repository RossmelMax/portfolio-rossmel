---
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { Image } from 'astro:assets';
import person from '../assets/rossmel-person.png';
import outline from '../assets/rossmel-outline.png?url';
/**
 * Foto en 3 capas (fondo, contorno y persona) con parallax al hacer scroll e inclinación con el mouse
 * (`data-layers` en animations.ts). Capas generadas por scripts/build-photo-layers.py: persona y
 * contorno son 28 % más altos (con la polera real de la foto original) para que nunca se vea un corte
 * al moverse. Sin JS / reduced-motion quedan alineadas y se ve la foto normal.
 */
interface Props { lang: Lang; loading?: 'lazy' | 'eager' }
const { lang, loading = 'lazy' } = Astro.props;
---
<div data-layers class="relative aspect-square" style="clip-path: inset(-40% 0 0 0 round 0 0 1.5rem 1.5rem)">
  <div class="absolute inset-0 rounded-3xl border border-line bg-black"></div>
  <div data-layer="0.5" data-layer-outline class="photo-outline absolute inset-x-0 top-0 h-[128%] origin-[50%_35%]" style={`--outline:url(${outline})`} aria-hidden="true"></div>
  <Image data-layer="1" src={person} alt={profile.photoAlt[lang]} widths={[360, 540, 720, 900]} sizes="(min-width: 768px) 26rem, 22rem" format="webp" class="absolute inset-x-0 top-0 block h-auto w-full" loading={loading} />
</div>
