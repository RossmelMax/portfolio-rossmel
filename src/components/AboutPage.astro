---
import type { Lang } from '../data/profile';
import { profile, story } from '../data/profile';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import PhotoLayers from './PhotoLayers.astro';
import Marked from './Marked.astro';
import Sketch from './Sketch.astro';
import { t, paths } from '../data/i18n';
import { postUrlById } from '../data/blog';
/**
 * Historia completa ("Sobre mí"): /sobre-mi/ y /en/about/. Texto y dibujos vienen de profile.ts (story).
 * Secciones intercaladas: texto a un lado y sus dibujos al otro, cada uno entra desde su costado (data-slide).
 */
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const altPath = paths.about(lang === 'es' ? 'en' : 'es');
const essayUrl = await postUrlById('programar-antes-de-la-ia', lang);
// Dónde van los dibujos secundarios alrededor del principal; las secciones de la derecha usan el espejo
const around = [
  ['left-[2%] top-[4%] h-14 w-14 -rotate-12 md:h-16 md:w-16', 'right-[4%] top-[12%] h-12 w-12 rotate-12 md:h-14 md:w-14', 'bottom-[2%] left-[20%] h-12 w-12 rotate-6 md:h-16 md:w-16'],
  ['right-[2%] top-[4%] h-14 w-14 rotate-12 md:h-16 md:w-16', 'left-[4%] top-[12%] h-12 w-12 -rotate-12 md:h-14 md:w-14', 'bottom-[2%] right-[20%] h-12 w-12 -rotate-6 md:h-16 md:w-16'],
];
---
<Base lang={lang} altPath={altPath} title={s.about.pageTitle} description={s.about.pageIntro}>
  <Nav lang={lang} altPath={altPath} onHome={false} />
  <main class="relative overflow-x-clip px-5 pb-24 pt-40 md:px-10">
    <div class="grid items-center gap-12 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="kicker mb-6">{s.about.pageKicker}</p>
        <h1 data-split class="display text-6xl font-bold md:text-8xl">{s.about.pageTitle}</h1>
        <Sketch name="scribble" seed={27} draw="scrub" class="mt-3 h-5 w-2/3 max-w-xl text-accent" />
        <p data-reveal class="mt-8 max-w-2xl text-lg text-muted md:text-xl">{s.about.pageIntro}</p>
        <div class="mt-10 flex flex-wrap items-center gap-4 text-muted" aria-hidden="true">
          {story.map((sec, i) => (
            <Sketch name={sec.doodles[0]} seed={i + 120} class={sec.doodles[0] === 'linux' ? 'h-9 w-[4.5rem]' : 'h-9 w-9'} />
          ))}
        </div>
      </div>
      <figure class="mx-auto w-full max-w-[20rem] md:col-span-4 md:col-start-9 md:max-w-[24rem]">
        <PhotoLayers lang={lang} loading="eager" />
        <figcaption class="kicker mt-4 flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent"></span>{profile.location[lang]}</figcaption>
      </figure>
    </div>

    <div class="mt-20 md:mt-28">
      {story.map((sec, i) => {
        const flip = i % 2 === 1;
        const [main, ...extra] = sec.doodles;
        return (
          <>
            {i > 0 && <Sketch name="hook" seed={i + 80} draw="scrub" class={`mx-auto my-2 block h-14 w-20 text-accent/60 md:h-20 md:w-28 ${flip ? '-scale-x-100' : ''}`} />}
            <section class="grid items-center gap-6 py-6 md:grid-cols-12 md:gap-12 md:py-10" data-draw-host>
              <div class={`relative mx-auto aspect-[4/3] w-full max-w-md md:col-span-5 md:max-w-none ${flip ? 'md:order-1' : 'md:order-2'}`} data-slide={flip ? 'left' : 'right'} data-reveal-delay="0.12" aria-hidden="true">
                <span class="display pointer-events-none absolute inset-0 flex select-none items-center justify-center text-[10rem] font-bold leading-none text-fg/[0.05] md:text-[13rem]">{String(i + 1).padStart(2, '0')}</span>
                <Sketch name={main} seed={i + 30} class={`absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-accent ${main === 'linux' ? 'h-28 w-56 md:h-32 md:w-64' : 'h-32 w-32 md:h-40 md:w-40'}`} />
                {extra.map((name, k) => (
                  <div class={`absolute ${around[flip ? 1 : 0][k]}`} data-parallax={String(0.12 + k * 0.1)}>
                    <Sketch name={name} seed={i * 7 + k + 90} class="h-full w-full text-fg/60" />
                  </div>
                ))}
              </div>
              <div class={`rounded-3xl border border-line bg-bg-2/60 p-7 md:col-span-7 md:p-10 ${flip ? 'md:order-2' : 'md:order-1'}`} data-slide={flip ? 'right' : 'left'}>
                <h2 class="display text-3xl font-semibold md:text-4xl">{sec.heading[lang]}</h2>
                <div class="mt-6 space-y-5 text-lg text-muted md:text-xl">
                  {sec.body[lang].map((p) => <p><Marked text={p} /></p>)}
                </div>
              </div>
            </section>
          </>
        );
      })}
    </div>

    <div class="relative mt-20 border-t border-line pt-10">
      <a href={essayUrl} data-hover class="inline-flex items-center gap-2 text-accent underline-offset-4 hover:underline">{s.about.essay} →</a>
      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href={paths.home(lang) + '#contact'} data-magnetic class="rounded-full bg-accent px-6 py-3 font-medium text-accent-ink">{s.about.cta} ↘</a>
        <a href={paths.home(lang)} class="kicker hover:text-fg">← {s.about.back}</a>
        <Sketch name="spark" seed={141} class="h-12 w-12 text-accent" />
      </div>
    </div>
  </main>
</Base>
