---
import type { Lang } from '../data/profile';
import { visibleProjects as projects } from '../data/profile';
import { t, paths } from '../data/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);
---
<section id="work" data-horizontal class="relative overflow-hidden md:h-screen">
  <div data-track class="flex h-full flex-col gap-6 px-5 py-24 md:flex-row md:items-center md:gap-10 md:px-10 md:py-0">
    <div class="shrink-0 md:w-[38vw] md:pr-[3vw]">
      <p class="kicker mb-6">{s.work.kicker}</p>
      <h2 class="display text-6xl font-bold md:text-[4.8vw]">{s.work.title}</h2>
      <p class="mt-6 font-mono text-sm text-muted">({String(featured.length).padStart(2, '0')}) →</p>
    </div>
    {featured.map((p, i) => (
      <a data-card data-hover href={paths.project(lang, p.slug)} class="group relative block shrink-0 no-underline md:w-[42vw]" style={`--c:${p.accent}`}>
        <div class="relative aspect-[4/3] overflow-hidden rounded-3xl border border-line bg-bg-2">
          <div data-card-media class="absolute inset-0" style={`background: radial-gradient(120% 90% at ${20 + i * 15}% 20%, color-mix(in oklab, ${p.accent} 70%, transparent), transparent 60%), radial-gradient(90% 90% at 90% 100%, color-mix(in oklab, ${p.accent} 30%, transparent), transparent 70%);`}></div>
          <span class="display absolute bottom-4 left-6 text-[9vw] font-bold leading-none text-fg/90 mix-blend-overlay md:text-[6vw]">{p.name}</span>
          <span class="absolute right-5 top-5 font-mono text-xs text-fg/70">{String(i + 1).padStart(2, '0')}</span>
        </div>
        <div class="mt-5 flex items-start justify-between gap-6">
          <div>
            <h3 class="display text-2xl font-semibold">{p.name} <span class="text-muted">· {p.year}</span></h3>
            <p class="mt-1 text-muted">{p.tagline[lang]}</p>
          </div>
          <span class="kicker shrink-0 transition-colors group-hover:text-[var(--c)]">{s.work.view} ↗</span>
        </div>
      </a>
    ))}
    <div class="w-[5vw] shrink-0"></div>
  </div>
</section>

<section class="px-5 py-24 md:px-10">
  <ul class="border-t border-line">
    {others.map((p) => (
      <li class="border-b border-line" data-reveal>
        <a href={paths.project(lang, p.slug)} data-hover class="group grid grid-cols-12 items-baseline gap-4 py-6 transition-colors hover:text-accent">
          <span class="display col-span-7 text-3xl font-semibold md:col-span-4 md:text-5xl">{p.name}</span>
          <span class="col-span-5 hidden text-muted md:col-span-5 md:block">{p.tagline[lang]}</span>
          <span class="kicker col-span-5 text-right md:col-span-3">{p.kind[lang]} · {p.year}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
