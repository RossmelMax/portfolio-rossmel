---
import type { Lang } from '../data/profile';
import { t, paths } from '../data/i18n';
import Logo from './Logo.astro';
interface Props { lang: Lang; altPath: string; onHome?: boolean }
const { lang, altPath, onHome = true } = Astro.props;
const s = t(lang);
const base = onHome ? '' : paths.home(lang);
const items = [
  ['#about', s.nav.about],
  ['#experience', s.nav.experience],
  ['#work', s.nav.work],
  ['#contact', s.nav.contact],
] as const;
const blogHref = paths.blog(lang);
---
<header data-nav class="fixed inset-x-0 top-0 z-50 px-3 py-3 sm:px-5 sm:py-4 md:px-10">
  <nav class="flex items-center justify-between gap-3 rounded-full border border-line bg-bg/60 py-2.5 pl-4 pr-2.5 backdrop-blur-xl sm:gap-6 sm:px-5 sm:py-3">
    <a href={paths.home(lang)} class="display flex items-center gap-2.5 text-lg font-semibold tracking-tight" aria-label="Rossmel Abasto"><Logo class="h-6 w-6 text-accent" /><span class="hidden min-[380px]:inline">rossmel<span class="text-accent">.</span></span></a>
    <ul class="hidden items-center gap-7 text-sm text-muted md:flex">
      {items.map(([href, label]) => (
        <li><a href={base + href} class="transition-colors hover:text-fg">{label}</a></li>
      ))}
      <li><a href={blogHref} class="transition-colors hover:text-fg">{s.nav.blog}</a></li>
    </ul>
    <div class="flex items-center gap-1.5 font-mono text-xs sm:gap-2">
      <a href={paths.cv(lang)} class="hidden rounded-full bg-accent px-4 py-2 font-medium text-accent-ink sm:inline-block">{s.nav.cv}</a>
      <a href={altPath} class="rounded-full border border-line px-3 py-2 hover:border-fg" hreflang={lang === 'es' ? 'en' : 'es'}>{s.langSwitch}</a>
      <button type="button" data-theme-toggle class="grid h-9 w-9 place-items-center rounded-full border border-line hover:border-fg" aria-label={s.nav.theme} title={s.nav.theme}>
        <!-- Luna en modo oscuro, sol en modo claro (se alterna por CSS según data-theme) -->
        <svg class="theme-moon h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z" /></svg>
        <svg class="theme-sun h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" /></svg>
      </button>
      <button type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" class="rounded-full border border-line px-3 py-2 md:hidden" data-open={s.nav.menu} data-close={s.nav.close}>{s.nav.menu}</button>
    </div>
  </nav>
</header>
<div id="mobile-menu" data-menu hidden class="fixed inset-0 z-[45] flex flex-col justify-end bg-bg px-5 pb-10 pt-28 md:hidden">
  <ul class="space-y-2">
    {items.map(([href, label], i) => (
      <li class="overflow-hidden">
        <a href={base + href} data-menu-link class="display block pb-[0.12em] text-[clamp(2.5rem,11vw,3.75rem)] leading-[1.05] font-bold" style={`--i:${i}`}>{label}</a>
      </li>
    ))}
    <li class="overflow-hidden"><a href={blogHref} data-menu-link class="display block pb-[0.12em] text-[clamp(2.5rem,11vw,3.75rem)] leading-[1.05] font-bold" style={`--i:${items.length}`}>{s.nav.blog}</a></li>
    <li class="overflow-hidden"><a href={paths.cv(lang)} data-menu-link class="display block pb-[0.12em] text-[clamp(2.5rem,11vw,3.75rem)] leading-[1.05] font-bold text-accent" style={`--i:${items.length + 1}`}>{s.nav.cv}</a></li>
  </ul>
</div>
<style>
  [data-menu]:not([hidden]) [data-menu-link] {
    animation: menu-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 60ms);
  }
  @keyframes menu-in {
    from { transform: translateY(110%); }
  }
</style>
<script>
  // Menú móvil
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const setMenu = (open: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? toggle.dataset.close! : toggle.dataset.open!;
    document.body.style.overflow = open ? 'hidden' : '';
  };
  toggle?.addEventListener('click', () => setMenu(Boolean(menu?.hidden)));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));

  document.querySelectorAll('[data-theme-toggle]').forEach((b) =>
    b.addEventListener('click', () => {
      const root = document.documentElement;
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch {}
    }),
  );
</script>
