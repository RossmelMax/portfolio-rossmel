---
import { sketchPaths, trailPaths, type SketchName } from '../data/sketches';
/**
 * Dibujo "en vuelo": una estela punteada que cruza el texto y termina en un dibujo (como el avión
 * de Contacto, pero con el ícono que corresponda: laptop, cubo, cohete…). Se traza al ritmo del
 * scroll. Ponerlo `absolute` dentro de un contenedor `relative`; es decorativo (aria-hidden).
 */
interface Props { icon: SketchName; seed?: number; variant?: number; class?: string; tilt?: number }
const { icon, seed = 1, variant = 0, class: cls = '', tilt = -10 } = Astro.props;
const trail = trailPaths(seed, variant);
const { viewBox, paths } = sketchPaths(icon, seed + 3);
const [, , vw, vh] = viewBox.split(' ').map(Number);
// el ícono entra en una caja de ~104 de alto (o de ancho si es apaisado), arriba a la derecha
const w = vw >= vh ? 108 : (108 * vw) / vh;
const h = vw >= vh ? (108 * vh) / vw : 108;
const x = 396 - w;
const y = Math.max(0, 60 - h / 2);
const stroke = { stroke: 'currentColor', 'stroke-width': 1.4, 'stroke-linecap': 'round', 'stroke-linejoin': 'round', pathLength: 1 } as const;
---
<svg viewBox="0 0 400 260" fill="none" aria-hidden="true" class={cls} data-draw="scrub">
  {trail.map((d) => <path d={d} {...stroke} />)}
  <g transform={`rotate(${tilt} ${x + w / 2} ${y + h / 2})`}>
    <svg x={x} y={y} width={w} height={h} viewBox={viewBox} overflow="visible">
      {paths.map((d) => <path d={d} {...stroke}/>)}
    </svg>
  </g>
</svg>
