---
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import { t } from '../data/i18n';
import { Image } from 'astro:assets';
import person from '../assets/rossmel-person.png';
import outline from '../assets/rossmel-outline.png?url';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const [lead, ...rest] = profile.about[lang];
---
<section id="about" class="px-5 py-32 md:px-10 md:py-48">
  <h2 class="kicker mb-10">{s.about.kicker}</h2>
  <p data-words class="display max-w-6xl text-4xl font-medium md:text-7xl">{lead}</p>
  <div class="mt-20 grid items-center gap-12 md:grid-cols-12">
    <figure class="mx-auto w-full max-w-[22rem] md:col-span-4 md:mx-0 md:max-w-[26rem]">
      <!--
        Foto en 3 capas (fondo, contorno y persona) con parallax al hacer scroll e inclinación con el mouse.
        Capas generadas desde rossmel.jpg: ver README → "Foto en capas". La persona y el contorno
        son 30 % más altos (la polera sigue hacia abajo) para que nunca se vea un corte al moverse. Sin JS / reduced-motion quedan
        alineadas y se ve igual que la foto original.
      -->
      <div data-layers class="relative aspect-square" style="clip-path: inset(-40% 0 0 0 round 0 0 1.5rem 1.5rem)">
        <div class="absolute inset-0 rounded-3xl border border-line bg-black"></div>
        <div data-layer="0.5" data-layer-outline class="photo-outline absolute inset-x-0 top-0 h-[130%] origin-[50%_35%]" style={`--outline:url(${outline})`} aria-hidden="true"></div>
        <Image data-layer="1" src={person} alt={profile.photoAlt[lang]} widths={[360, 540, 720, 900]} sizes="(min-width: 768px) 26rem, 22rem" format="webp" class="absolute inset-x-0 top-0 block h-auto w-full" loading="lazy" />
      </div>
      <figcaption class="kicker mt-4 flex items-center gap-2"><span class="h-2 w-2 rounded-full bg-accent"></span>{profile.location[lang]}</figcaption>
    </figure>
    <div class="space-y-6 text-lg text-muted md:col-span-7 md:col-start-6 md:text-xl">
      {rest.map((p, i) => <p data-reveal data-reveal-delay={i * 0.08}>{p}</p>)}
    </div>
  </div>
  <dl class="mt-24 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-4">
    {profile.stats.map((st) => (
      <div class="bg-bg p-6 md:p-8" data-reveal>
        <dt class="kicker">{st.label[lang]}</dt>
        <dd class="display mt-4 text-5xl font-bold md:text-7xl">
          <span data-count={st.count} data-suffix={st.suffix}>{st.count.toLocaleString(lang)}{st.suffix}</span>
        </dd>
      </div>
    ))}
  </dl>
</section>
