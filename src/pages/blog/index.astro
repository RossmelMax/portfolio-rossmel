---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import { getPosts, readingTime, fmtDate } from '../../data/blog';
import { t, paths } from '../../data/i18n';
const lang = 'es';
const s = t(lang);
const posts = await getPosts();
---
<Base lang={lang} altPath="/en/" title={s.blog.kicker} description={s.blog.intro}>
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog de Rossmel Abasto" href="/blog/rss.xml" />
  <Nav lang={lang} altPath="/en/" onHome={false} />
  <main class="px-5 pb-24 pt-40 md:px-10">
    <p class="kicker mb-6">{s.blog.kicker} · <a href="/blog/rss.xml" class="hover:text-fg">{s.blog.rss}</a></p>
    <h1 data-split class="display max-w-5xl text-6xl font-bold md:text-8xl">{s.blog.title}</h1>
    <p data-reveal class="mt-8 max-w-2xl text-lg text-muted md:text-xl">{s.blog.intro}</p>
    <ul class="mt-20 border-t border-line">
      {posts.map((p) => (
        <li class="border-b border-line" data-reveal>
          <a href={paths.post(p.id)} data-hover class="group grid gap-3 py-10 md:grid-cols-12 md:gap-8">
            <span class="kicker md:col-span-3">{fmtDate(p.data.date, lang)} · {readingTime(p.body)} {s.blog.read}</span>
            <span class="md:col-span-9">
              <span class="display block text-3xl font-semibold transition-colors group-hover:text-accent md:text-5xl">{p.data.title}</span>
              <span class="mt-3 block max-w-3xl text-muted">{p.data.description}</span>
              <span class="mt-4 flex flex-wrap gap-2">{p.data.tags.map((tag) => <span class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">#{tag}</span>)}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
