---
import Base from '../layouts/Base.astro';
import { t, paths } from '../data/i18n';
// Una sola 404 para ambos idiomas (Cloudflare Pages sirve /404.html): texto en ES y EN.
const es = t('es').notFound;
const en = t('en').notFound;
---
<Base lang="es" altPath="/en/" title="404" description={es.title}>
  <main class="flex min-h-[100svh] flex-col justify-end px-5 pb-12 md:px-10">
    <p class="display text-[40vw] font-bold leading-none text-accent md:text-[28vw]" data-split>404</p>
    <div class="mt-8 grid gap-8 border-t border-line pt-8 md:grid-cols-2">
      <div data-reveal>
        <h1 class="display text-3xl font-semibold md:text-5xl">{es.title}</h1>
        <p class="mt-3 text-muted">{es.body}</p>
        <a href={paths.home('es')} class="kicker mt-6 inline-block hover:text-fg">← {es.home}</a>
      </div>
      <div data-reveal data-reveal-delay="0.1" lang="en">
        <h2 class="display text-3xl font-semibold md:text-5xl">{en.title}</h2>
        <p class="mt-3 text-muted">{en.body}</p>
        <a href={paths.home('en')} class="kicker mt-6 inline-block hover:text-fg">← {en.home}</a>
      </div>
    </div>
  </main>
</Base>
