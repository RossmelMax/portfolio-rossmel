---
import '../styles/global.css';
import type { Lang } from '../data/profile';
import { profile } from '../data/profile';
import fontDisplay from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import fontText from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Ruta equivalente en el otro idioma (para hreflang y el switch ES/EN). */
  altPath: string;
  /** Páginas "limpias" (CV) no cargan animaciones ni cursor. */
  plain?: boolean;
  /** 'article' en los artículos del blog. */
  ogType?: 'website' | 'article';
  /** Sin versión en el otro idioma (artículos): no se emite hreflang alternativo. */
  noAlt?: boolean;
}
const { lang, title, description, altPath, plain = false, ogType = 'website', noAlt = false } = Astro.props;
// Cloudflare Web Analytics: token público, se define en Pages → Settings → Variables (build).
const cfBeacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const pageTitle = title ? `${title} — ${profile.name}` : `${profile.name} — ${profile.role[lang]}`;
const desc = description ?? profile.headline[lang];
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(altPath, Astro.site);
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role.en,
  email: `mailto:${profile.email}`,
  url: profile.portfolioUrl,
  sameAs: Object.values(profile.links).filter(Boolean),
  address: { '@type': 'PostalAddress', addressLocality: 'Cochabamba', addressCountry: 'BO' },
};
---
<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    {!noAlt && <link rel="alternate" hreflang={lang} href={canonical} />}
    {!noAlt && <link rel="alternate" hreflang={lang === 'es' ? 'en' : 'es'} href={alt} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/site.webmanifest?v=2" />
    <meta name="theme-color" content="#0a0a0b" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <!-- Tema y movimiento antes de pintar: evita parpadeos -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        try {
          var t = localStorage.getItem('theme');
          // Oscuro por defecto (el diseño está pensado dark-first); respeta la elección guardada.
          if (t !== 'light') t = 'dark';
          root.dataset.theme = t;
          if (sessionStorage.getItem('preloaded') === '1') root.classList.add('booted');
        } catch (e) {}
        try {
          // 'reduced' forzado por el botón del header, o si no, lo que diga el sistema.
          var m = localStorage.getItem('motion');
          var reduced = m === 'reduced' || matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.dataset.motion = reduced ? 'reduced' : 'auto';
          if (!reduced) {
            // Esconde el nombre del hero hasta que animations.ts arranque su animación (heroIntro
            // la quita en el mismo tick). Si algo falla, se revela sola a los 3 s.
            root.classList.add('hero-pending');
            setTimeout(function () { root.classList.remove('hero-pending'); }, 3000);
          }
        } catch (e) {}
      })();
    </script>
    <noscript><style>[data-preloader]{display:none!important}[data-hero-title],[data-hero-fade]{opacity:1!important}</style></noscript>
    <style is:global>
      @view-transition { navigation: auto; }
    </style>
    {cfBeacon && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfBeacon })}></script>
    )}
    <slot name="head" />
  </head>
  <body class={plain ? '' : 'cursor-none-fine'}>
    <slot />
    {!plain && <div class="grain" aria-hidden="true"></div>}
    {!plain && <div class="cursor" data-cursor aria-hidden="true"></div>}
    {!plain && (
      <script>
        import { initAnimations } from '../scripts/animations';
        initAnimations();
      </script>
    )}
  </body>
</html>
